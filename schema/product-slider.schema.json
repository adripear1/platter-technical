{
  "name": "Product slider",
  "tag": "section",
  "class": "product-slider-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large"
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop all label",
      "default": "Shop All Best Sellers"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop all link",
      "info": "Defaults to the selected collection."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products to show",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 10,
      "info": "Ten products at most."
    },
    {
      "type": "range",
      "id": "mobile_initial",
      "label": "Products before Show more",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4,
      "info": "Below 768px only this many cards show. Show more drops the rest open. Desktop still slides the full set."
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "text",
      "id": "best_seller_label",
      "label": "Best seller label",
      "default": "Best seller",
      "info": "Shown on the left of the image."
    },
    {
      "type": "text",
      "id": "best_seller_tag",
      "label": "Best seller tag",
      "default": "best-seller",
      "info": "Products with this tag get the left badge. Matching ignores case, spaces, and hyphens."
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Discount label",
      "default": "Save",
      "info": "Shown on the right of the image, followed by the discount. Example: Save 20%."
    },
    {
      "type": "select",
      "id": "discount_format",
      "label": "Discount format",
      "options": [
        {
          "value": "percent",
          "label": "Percentage"
        },
        {
          "value": "amount",
          "label": "Amount"
        }
      ],
      "default": "percent"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "cards_visible",
      "label": "Cards visible on desktop",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "3.5",
          "label": "3.5"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "4.5",
          "label": "4.5"
        },
        {
          "value": "4.75",
          "label": "4.75"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "5.5",
          "label": "5.5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "default": "4.75",
      "info": "From 768px up. 4.75 shows four full cards and a peek of the next."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ],
      "default": "page"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show progress bar",
      "default": true
    },
    {
      "type": "text",
      "id": "show_more_label",
      "label": "Show more label",
      "default": "Show more"
    },
    {
      "type": "text",
      "id": "show_less_label",
      "label": "Show less label",
      "default": "Show less"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Review text"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background"
    },
    {
      "type": "color",
      "id": "bestseller_background",
      "label": "Best seller background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bestseller_text",
      "label": "Best seller text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "save_background",
      "label": "Discount background",
      "default": "#5C7962"
    },
    {
      "type": "color",
      "id": "save_text",
      "label": "Discount text",
      "default": "#FFFFFA"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color"
    },
    {
      "type": "color",
      "id": "progress_color",
      "label": "Progress bar"
    },
    {
      "type": "color",
      "id": "progress_track_color",
      "label": "Progress track"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Product slider",
      "category": "Products",
      "settings": {
        "heading": "Best sellers",
        "heading_size": "large",
        "shop_all_label": "Shop All Best Sellers",
        "max_products": 10,
        "mobile_initial": 4,
        "best_seller_label": "Best seller",
        "best_seller_tag": "best-seller",
        "save_label": "Save",
        "discount_format": "percent",
        "cards_visible": "4.75",
        "gap": 24,
        "image_ratio": "square",
        "card_radius": 10,
        "section_width": "page",
        "show_progress": true,
        "show_more_label": "Show more",
        "show_less_label": "Show less",
        "padding_top": 64,
        "padding_bottom": 64
      }
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
